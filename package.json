{
  "name": "ai-sdlc-workshop",
  "version": "1.0.0",
  "description": "Hands-on sandbox for the AI-Augmented SDLC framework: MCP + Copilot Agent Mode + Playwright + Allure + AI metrics",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:all": "npm run clean:results && npm test && npm run test:e2e",
    "test:list": "node scripts/list-tests.mjs",
    "report": "allure generate allure-results",
    "report:open": "allure open allure-report",
    "demo:failure": "cross-env-shell DEMO_FAILURE=1 playwright test tests/e2e/demo-failure.spec.js",
    "clean:results": "node scripts/clean.mjs",
    "ado:board": "node tools/mock-ado-mcp/board.mjs",
    "ado:reset": "node tools/mock-ado-mcp/reset.mjs",
    "metrics": "node scripts/ai-metrics.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@playwright/mcp": "^0.0.82",
    "@playwright/test": "^1.63.0",
    "allure": "^3.18.0",
    "allure-jest": "^3.12.2",
    "allure-playwright": "^3.12.2",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "zod": "^4.6.5"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
